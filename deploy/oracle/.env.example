# Oracle Cloud deployment environment. Copy to .env and fill in real values.
# docker compose reads this file automatically.

# PostgreSQL credentials (the app and the db container both use these).
POSTGRES_USER=devil
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=devil

# Non-interactive owner bootstrap (created on first startup if no owner exists).
OWNER_USERNAME=owner
OWNER_PASSWORD=change-this-to-a-12plus-char-password
