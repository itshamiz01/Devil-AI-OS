# AUTONOMUS inert configuration example. No real secrets.
# P-01 backend uses AUTONOMUS_* variables validated by backend/app/core/config.py.
AUTONOMUS_ENVIRONMENT=development
AUTONOMUS_HOST=127.0.0.1
AUTONOMUS_PORT=8000
AUTONOMUS_ALLOW_REMOTE_ACCESS=false
# External database, e.g. a Supabase postgresql:// connection string.
# Leave empty to keep the local SQLite database (the tested default).
AUTONOMUS_DATABASE_URL=
# Direct (non-pooled) connection, used for migrations only. A transaction
# pooler breaks multi-statement DDL, so runtime and migrations differ.
AUTONOMUS_DATABASE_URL_direct=
# Set false on a serverless host to stop re-applying the chain on every
# cold start; apply migrations deliberately instead.
AUTONOMUS_RUN_MIGRATIONS_ON_STARTUP=true
AUTONOMUS_LOG_LEVEL=INFO
AUTONOMUS_LOG_MAX_BYTES=1048576
AUTONOMUS_LOG_BACKUP_COUNT=3
# Verified database snapshots; retention bounded so backups cannot consume the
# disk the monitor watches. Restore is CLI-only, never an HTTP endpoint (ADR-0014).
# AUTONOMUS_BACKUP_DIR is a path and is deliberately not set here: the default
# resolves relative to the repository root, and a relative override would follow
# the process working directory instead.
AUTONOMUS_BACKUP_RETENTION_COUNT=7
AUTONOMUS_TASK_QUEUE_CAPACITY=100
AUTONOMUS_TASK_MAX_CONCURRENCY=2
AUTONOMUS_TASK_DEFAULT_TIMEOUT=30
AUTONOMUS_TASK_MAX_RETRIES=3
AUTONOMUS_SHUTDOWN_TIMEOUT=10
AUTONOMUS_MEMORY_PERCENT_MAX=90
AUTONOMUS_DISK_PERCENT_MAX=90
AUTONOMUS_SESSION_TTL_MINUTES=60
AUTONOMUS_LOGIN_RATE_LIMIT=5
# Lifetime of the approval that gates an approval_required task (60-86400).
# On expiry the task is cancelled by the scheduler sweep, never left waiting.
AUTONOMUS_TASK_APPROVAL_TTL_SECONDS=3600
AUTONOMUS_EXTERNAL_EXECUTION_ENABLED=false
AUTONOMUS_FINANCIAL_EXECUTION_ENABLED=false
AUTONOMUS_CLOUD_AI_ENABLED=false

# --- P-02 Master Intelligence Engine -----------------------------------
# Defaults keep the engine fully functional with ZERO models installed: it
# reports an explicit limitation instead of fabricating reasoning. Point
# AUTONOMUS_MODEL_PROVIDER at ollama and set AUTONOMUS_REGISTERED_MODEL_ID to an already
# downloaded model to enable local inference. Weights are never fetched here.
# Master switch for the intelligence engine. When false, `/api/v1/intelligence` answers `409` rather than pretending to work
AUTONOMUS_INTELLIGENCE_ENABLED=true
# `none` or `ollama`. With `none` no runtime is registered, so generation returns an explicit limitation instead of a fabricated answer (§6.4)
AUTONOMUS_MODEL_PROVIDER=none
# Identifier of an **already downloaded** local model. Weights are never fetched by the application; an empty value registers no model
AUTONOMUS_REGISTERED_MODEL_ID=
# Declared context window in tokens (512-2000000). A request exceeding it is refused or shortened, never silently truncated (§6.5)
AUTONOMUS_REGISTERED_MODEL_CONTEXT_WINDOW=4096
# RAM the model needs, in GiB (0-64). Drives memory-aware admission so inference cannot starve the Core OS (§18)
AUTONOMUS_REGISTERED_MODEL_MIN_RAM_GB=1.0
# Loopback only. A non-loopback value is rejected at startup by `validate_inference_endpoint`
AUTONOMUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Simultaneous in-flight generations (1-8)
AUTONOMUS_INFERENCE_MAX_CONCURRENT=1
# Per-generation timeout in seconds (>0, <=600). On timeout the router falls back to another *permitted* model or reports the limitation
AUTONOMUS_INFERENCE_TIMEOUT_SECONDS=60
# Fraction of available RAM inference may commit (>0, <=1). The remainder is headroom reserved for the Core OS
AUTONOMUS_INFERENCE_RAM_SAFETY_FRACTION=0.8
# Cost ceiling per 1k tokens (0-100). `0.0` means local-only: no paid model can satisfy it
AUTONOMUS_INFERENCE_MAX_COST_PER_1K_TOKENS=0.0
# Must remain false while `AUTONOMUS_CLOUD_AI_ENABLED` is false. Even when true, cloud routing stays inert until the owner enables that phase flag
AUTONOMUS_INFERENCE_CLOUD_EGRESS_PERMITTED=false
# How long a health probe is cached in seconds (>0, <=3600). Health is probed lazily so startup never blocks on an absent model server (§18)
AUTONOMUS_MODEL_HEALTH_TTL_SECONDS=60
# Assembled context budget in tokens (256-32768). Overflow raises `ContextOverflowError` rather than silently dropping a protected financial or security constraint (§12.3)
AUTONOMUS_CONTEXT_TOKEN_BUDGET=2048
# `0_advisory`, `1_assisted_execution` or `2_controlled_autonomy`. Levels 3 and 4 are not valid values and are refused at configuration load (§15)
AUTONOMUS_AUTONOMY_LEVEL=0_advisory
# Maximum steps in one plan (1-64). A larger plan is rejected rather than truncated
AUTONOMUS_PLAN_MAX_STEPS=24
# Tasks one mission may have in flight (1-8), so a single mission cannot monopolise the P-01 queue (§18)
AUTONOMUS_MISSION_MAX_CONCURRENT_TASKS=2
# INERT — not a Settings field; extra="ignore" discards it silently. P-01
# implements no operating modes, and the four modes P-12 requires are not named
# in any approved document, so no semantics have been invented here.
# Owner decision D-15: wire it as a real validated mode, or remove this line.
AUTONOMUS_OPERATING_MODE=simulation

# ---- P-03 Opportunity Discovery Engine ----
# There is deliberately NO setting here that permits spending money: §26 prohibits
# purchasing domains, subscriptions, datasets or advertising, placing orders,
# registering a business, signing a contract, collecting payment or creating any
# financial obligation, at every autonomy level. GovernanceGate refuses those
# actions outright; a configuration key would imply a capability that does not exist.
# Builds the P-03 Opportunity Discovery Engine at startup. When false, Services.opportunities is None and every /api/v1/opportunities route returns 409 rather than serving a half-built engine
AUTONOMUS_OPPORTUNITIES_ENABLED=true
# Comma-separated network egress allowlist for research. DENY BY DEFAULT AND EMPTY BY DEFAULT: no external host may be contacted unless named here, and a listed subdomain never authorises its parent. Empty means every acquisition returns a refusal per source, which the report states plainly instead of inventing market data (§27, §19)
AUTONOMUS_RESEARCH_PERMITTED_HOSTS=
# Sources contacted in one acquisition sweep (1-50); also the per-source per-minute request ceiling, so a sweep cannot exceed a descriptor's declared rate limit (§30)
AUTONOMUS_RESEARCH_MAX_SOURCES_PER_SWEEP=10
# Per-request acquisition timeout in seconds (>0, <=120). A timeout is recorded as a refusal with its reason, never retried silently
AUTONOMUS_RESEARCH_TIMEOUT_SECONDS=15.0
# Cap on retrieved content (1000-20000000). Retrieved content is untrusted input: it is truncated before parsing and never executed (§27)
AUTONOMUS_RESEARCH_MAX_RESPONSE_BYTES=1000000
# Evidence records one sweep may create (1-5000), bounding memory and database growth (§30)
AUTONOMUS_RESEARCH_MAX_EVIDENCE_PER_SWEEP=200
# Validation level (0-5) required before an opportunity may be RECOMMENDED. Levels 4 and 5 need money to have actually changed hands, which §26 forbids this phase from arranging, so 5 makes recommendation unreachable by design rather than by accident
AUTONOMUS_OPPORTUNITY_MINIMUM_VALIDATION_LEVEL=3
# Open opportunities the engine will hold (1-1000). Opening beyond it returns 409 rather than growing without bound (§30)
AUTONOMUS_OPPORTUNITY_MAX_OPEN=50
# Age in days (1-3650) after which evidence is marked OUTDATED and stops counting towards coverage. A stale figure is not a current one
AUTONOMUS_EVIDENCE_STALE_AFTER_DAYS=180

# --- P-04 Dynamic Agent Factory (Stage 4) ---
# Builds the P-04 subsystem at startup. When false, /api/v1/agents, /api/v1/agent-templates and /api/v1/agent-factory all answer 409 naming this setting, so a disabled phase reports that it is disabled instead of failing with a 500
AUTONOMUS_AGENTS_ENABLED=true
# Live agents the registry will hold (1-64). Everything except RETIRED counts: a suspended or failed agent still exists and still holds its identity and permissions. At the ceiling a creation is queued, not refused, unless the queue is full too
AUTONOMUS_AGENT_MAX_TOTAL=12
# Live agents from one template (1-32), so a single template cannot fill the registry and make every agent fail the same way at once
AUTONOMUS_AGENT_MAX_PER_TEMPLATE=4
# Queued creation requests held (1-200). A full queue produces REJECT with the queue depth in the reason, because queuing without a bound is refusing slowly and without telling anyone
AUTONOMUS_AGENT_MAX_CREATION_QUEUE=20
# Delegation depth an agent may reach through sub-agents it caused to be created (0-4). 0 forbids a parent entirely; the parent chain is also walked for cycles
AUTONOMUS_AGENT_MAX_DELEGATION_DEPTH=2
# The owner's emergency stop is deliberately NOT configured here. It is durable
# runtime state in the system_configurations table, controlled only through the
# owner-only /api/v1/system/emergency endpoints, so it survives restart and no
# automatic or configuration-editing path can clear it (ADR-0013).
# Never put real credentials here; see docs/architecture/SECRET_STORE_DESIGN.md
# (design only in P-01; no secret store is implemented yet — ADR-0012).
