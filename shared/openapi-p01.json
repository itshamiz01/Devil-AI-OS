{
  "components": {
    "schemas": {
      "ApprovalCreateRequest": {
        "properties": {
          "action": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Action",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "requested_permissions": {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "title": "Requested Permissions",
            "type": "array"
          },
          "resource": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Resource",
            "type": "string"
          },
          "risk": {
            "default": "medium",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Risk",
            "type": "string"
          },
          "ttl_seconds": {
            "default": 3600,
            "maximum": 86400.0,
            "minimum": 60.0,
            "title": "Ttl Seconds",
            "type": "integer"
          }
        },
        "required": [
          "action",
          "resource",
          "reason"
        ],
        "title": "ApprovalCreateRequest",
        "type": "object"
      },
      "ApprovalDecisionRequest": {
        "properties": {
          "decision": {
            "enum": [
              "approved",
              "rejected"
            ],
            "title": "Decision",
            "type": "string"
          },
          "notes": {
            "default": "",
            "maxLength": 2000,
            "title": "Notes",
            "type": "string"
          }
        },
        "required": [
          "decision"
        ],
        "title": "ApprovalDecisionRequest",
        "type": "object"
      },
      "EmergencyRequest": {
        "description": "Reason is mandatory so the audit trail records why the owner acted.\n\nBounded length because it is persisted and echoed back to authorized\ncallers; it is never written to logs (see core/emergency.py).",
        "properties": {
          "reason": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "EmergencyRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "TaskSubmitRequest": {
        "properties": {
          "approval_required": {
            "default": false,
            "title": "Approval Required",
            "type": "boolean"
          },
          "deadline": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline"
          },
          "description": {
            "default": "",
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "handler": {
            "enum": [
              "system.noop",
              "system.echo",
              "system.wait"
            ],
            "title": "Handler",
            "type": "string"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "max_retries": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Max Retries",
            "type": "integer"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "priority": {
            "default": 5,
            "maximum": 9.0,
            "minimum": 0.0,
            "title": "Priority",
            "type": "integer"
          },
          "timeout_seconds": {
            "default": 30.0,
            "exclusiveMinimum": 0.0,
            "maximum": 3600.0,
            "title": "Timeout Seconds",
            "type": "number"
          }
        },
        "required": [
          "name",
          "handler"
        ],
        "title": "TaskSubmitRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
