  "components": {
    "schemas": {
      "ApprovalCreateRequest": {
        "properties": {
          "action": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Action"
          },
          "resource": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Resource"
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Risk",
            "default": "medium"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason"
          },
          "requested_permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Requested Permissions"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters"
          },
          "ttl_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 60.0,
            "title": "Ttl Seconds",
            "default": 3600
          }
        },
        "type": "object",
        "required": [
          "action",
          "resource",
          "reason"
        ],
        "title": "ApprovalCreateRequest"
      },
      "ApprovalDecisionRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "title": "Decision"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "ApprovalDecisionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
